# Copy this file to .env and fill it in.

# Instagram (Meta Graph API, "Instagram API with Facebook Login")
# Your OWN Instagram Business/Creator account ID (the account doing the looking up)
IG_USER_ID=
# Long-lived user access token from your Meta app
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v26.0
# How many recent posts to pull per club
POSTS_PER_CLUB=20

# Optional: lets Claude read event flyers (text inside images) and captions more accurately.
# Leave blank to use the built-in rule-based extractor only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: where to send results. The whole payload is POSTed as JSON after each run.
DB_WEBHOOK_URL=
