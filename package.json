{
  "name": "clubhub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --no-warnings --test tests/*.test.js",
    "preview": "vite preview",
    "server": "node --no-warnings server/index.js",
    "sync:static": "node --no-warnings server/exportStatic.js",
    "sync:rosters": "node --no-warnings server/syncRosters.js",
    "scout:discord": "node --no-warnings server/scoutDiscordServers.js",
    "sync:push": "bash scripts/local-sync-and-push.sh",
    "ig:login": "(.venv/bin/python3 collector/scripts/setup_ig_session.py || python3 collector/scripts/setup_ig_session.py)",
    "ig:extend-token": "node --no-warnings collector/scripts/extend_meta_token.mjs",
    "ig:check-token": "node --no-warnings collector/scripts/check_meta_token.mjs",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "@clerk/react": "^6.18.8",
    "@clerk/themes": "^2.4.57",
    "@supabase/supabase-js": "^2.119.0",
    "chrono-node": "^2.10.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.8",
    "vite": "^6.3.5"
  }
}
