# ── ClubHub Backend Configuration ──
# Copy this file to .env and fill in the values.

PORT=3001

# Clerk Authentication (Get this from https://dashboard.clerk.com/ -> API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_c2VjdXJlLWNvdy0zMDI1LmNsZXJrLmFjY291bnRzLmRldiQ

# Instagram Graph API (https://developers.facebook.com/)
