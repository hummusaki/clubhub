# ── ClubHub Backend & Collector Configuration ──
# Copy this file to .env and fill in the values you want enabled.

PORT=3001

# Optional: Frontend API base URL (only needed if hosting Express/Cloudflare backend remotely)
# VITE_API_BASE_URL=https://clubhub-private-api.onrender.com/api

# ── 0. Free Hosted Private Multi-User Database (Turso Cloud SQLite — https://turso.tech) ──
# Keeps all user accounts, roster claims, club groups, polls, and tasks in a private remote DB
# (NOT on your PC, and NEVER in `public/clubhub-data.json`). Free tier: 5 GB storage, 500M reads/mo.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── 0. Supabase Cloud PostgreSQL + Auth + RLS (Primary Cloud Database) ──
# Create a free project at https://supabase.com/dashboard -> Project Settings -> API
# Run `supabase/schema.sql` in the Supabase SQL Editor, then paste your keys in `.env` or `.env.local`:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Clerk Authentication (https://dashboard.clerk.com/ -> API Keys)
# Store your real keys ONLY in .env (gitignored) or GitHub Repository Secrets
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Optional: Direct Google OAuth Web Client ID (https://console.cloud.google.com/apis/credentials)
# Used if Clerk Google SSO is not enabled on your Clerk instance
VITE_GOOGLE_CLIENT_ID=

# ── 1. Discord #announcements Sync (https://discord.com/developers/applications) ──
DISCORD_BOT_TOKEN=your_bot_token

# Option A (Recommended): Put your bot in ONE private ClubHub Discord server, click "Follow"
# on any UCSC club's #announcements channel into your server, and set your server's ID here:
DISCORD_AGGREGATOR_GUILD_ID=

# Option B: Comma-separated explicit clubHandle:channelId pairs
# DISCORD_CHANNEL_MAP=ucsc_csclub:123456789012345678,ucscdebate:234567890123456789

# Optional outbound Discord defaults (Incoming Webhook URL or default Bot Channel ID)
DISCORD_WEBHOOK_URL=
DISCORD_DEFAULT_CHANNEL_ID=

# Optional shared secret for POST /api/webhooks/discord & POST /api/webhooks/email
WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=

# ── 2. Instagram Official Business Discovery + Story Mention Webhook ──
# Setup steps in collector/README.md (free, zero ban risk)
IG_USER_ID=
IG_ACCESS_TOKEN=
INSTAGRAM_APP_ID=your_app_id
INSTAGRAM_APP_SECRET=your_app_secret
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=clubhub_verify

# Optional: Vision LLM key so flyer images & Story Mentions with no text caption get parsed
ANTHROPIC_API_KEY=

# ── 3. Instagram Personal-Account Fallback Scraper (Run locally on residential Wi-Fi) ──
# Requires `pip3 install instaloader`
IG_PERSONAL_FALLBACK=false
IG_SCRAPER_DELAY_SEC=10
# Optional burner account session for higher limits / active 24h stories (high ban risk if overused):
IG_SCRAPER_SESSION_USER=
IG_SCRAPER_STORIES=false

# ── 4. Google Calendar & Email Integrations (IMAP + SMTP App Password or Resend/SendGrid) ──
GOOGLE_CALENDAR_API_KEY=your_api_key

# Inbound IMAP + Outbound SMTP (e.g. Gmail or @ucsc.edu with a 16-char Google App Password)
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_MAILBOX=INBOX
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_FROM=
EMAIL_FROM_NAME=ClubHub Campus Sync

# Optional HTTP Email API alternative for outbound digests & invites
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SENDGRID_API_KEY=

# ── 5. Grounded AI Overview Search (Google Gemini 4 Interactions API) ──
# Optional: Get a free API key at https://aistudio.google.com/apikey to upgrade
# Hybrid Semantic RAG into live Gemini 4 (`gemini-4-hydrogen`) conversational synthesis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

